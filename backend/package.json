{
  "name": "kodomo-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Kodomo family ecosystem backend (NestJS modular monolith): OTP auth, family sync, content CMS, forum, licenses, live usage WebSocket.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:admin": "node dist/scripts/create-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/platform-ws": "10.4.15",
    "@nestjs/typeorm": "10.0.2",
    "@nestjs/websockets": "10.4.15",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "ioredis": "5.4.2",
    "minio": "8.0.3",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/express": "4.17.21",
    "@types/node": "20.17.10",
    "@types/ws": "8.5.13",
    "ts-node-dev": "2.0.0",
    "typescript": "5.6.3"
  }
}
